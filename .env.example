# Copy to .env.local and fill in. Never commit .env.local. Details: docs/tools.md §4.

# --- Required ---
# Signs session cookies, at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
OPENROUTER_API_KEY=
# mongodb:// or mongodb+srv:// (MongoDB Atlas or Atlas Local; plain Community has no Atlas Search)
MONGODB_URI=

# --- AI models (free only unless AI_ALLOW_PAID=true) ---
# Model for Add from Text and Ask AI. Must support tool calling. Default: openrouter/free
AI_MODEL_TEXT=
# Model for Add from Photo. Must accept image input. Default: openrouter/free
AI_MODEL_VISION=
# Comma-separated fallbacks (text: each must support tools; vision: each must accept images)
AI_FALLBACK_MODELS_TEXT=
AI_FALLBACK_MODELS_VISION=
# schema (response_format json_schema) or prompt (schema written into the prompt). Default: schema
AI_JSON_MODE=
# allow or deny (deny = only providers that do not collect prompts). Default: allow
AI_DATA_COLLECTION=
# true allows a model id that is not free. Default: false
AI_ALLOW_PAID=

# --- AI limits ---
# Timeout of one AI request, ms. Default: 60000
AI_TIMEOUT_MS=
# Total time of one user action, ms (not below AI_TIMEOUT_MS, max 280000). Default: 120000
AI_DEADLINE_MS=
# max_tokens of every AI request. Default: 8000
AI_MAX_TOKENS=
# AI actions one person may start per day, 0 = no limit. Default: 15
AI_USER_DAILY_LIMIT=

# --- App ---
# IANA time zone for dates, date filters and the AI day. Default: Asia/Baghdad
APP_TIME_ZONE=
# Database name. Default: cards
MONGODB_DB=
# Database used AND EMPTIED by eval:search only. Default: cards_eval
EVAL_DB=
# Longest text for Add from Text. Default: 20000
MAX_TEXT_CHARS=
# Largest photo upload in MB (max 20). Default: 20
MAX_IMAGE_MB=
# Only for tests (mock AI server, e.g. http://127.0.0.1:4010). Default: https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=
