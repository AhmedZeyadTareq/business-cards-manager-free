{
  "name": "business-cards-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "test:db": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.db.config.mts",
    "db:setup": "node --env-file-if-exists=.env.local --import tsx scripts/db-setup.ts",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "users:add-admin": "node --env-file-if-exists=.env.local --import tsx scripts/users-add-admin.ts",
    "import:csv": "node --env-file-if-exists=.env.local --import tsx scripts/import-csv.ts",
    "fixtures:photos": "node --env-file-if-exists=.env.local --import tsx scripts/make-photo-fixtures.ts",
    "ai:models": "node --env-file-if-exists=.env.local --import tsx scripts/ai-models.ts",
    "ai:smoke": "node --env-file-if-exists=.env.local --import tsx scripts/ai-smoke.ts",
    "eval:text": "node --env-file-if-exists=.env.local --import tsx scripts/eval-text.ts",
    "eval:photo": "node --env-file-if-exists=.env.local --import tsx scripts/eval-photo.ts",
    "eval:search": "node --env-file-if-exists=.env.local --import tsx scripts/eval-search.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "heic-convert": "^2.1.0",
    "lucide-react": "^1.72.0",
    "mongodb": "^7.9.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.9"
  }
}
