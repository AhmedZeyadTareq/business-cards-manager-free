{
  "analyzer": "fold",
  "searchAnalyzer": "fold",
  "analyzers": [
    {
      "name": "fold",
      "charFilters": [
        {
          "type": "mapping",
          "mappings": {
            "أ": "ا",
            "إ": "ا",
            "آ": "ا",
            "ٱ": "ا",
            "ة": "ه",
            "ى": "ي",
            "ـ": "",
            "٠": "0",
            "١": "1",
            "٢": "2",
            "٣": "3",
            "٤": "4",
            "٥": "5",
            "٦": "6",
            "٧": "7",
            "٨": "8",
            "٩": "9",
            "ی": "ي",
            "ک": "ك",
            "۰": "0",
            "۱": "1",
            "۲": "2",
            "۳": "3",
            "۴": "4",
            "۵": "5",
            "۶": "6",
            "۷": "7",
            "۸": "8",
            "۹": "9"
          }
        }
      ],
      "tokenizer": { "type": "standard" },
      "tokenFilters": [{ "type": "icuFolding" }, { "type": "lowercase" }]
    }
  ],
  "mappings": {
    "dynamic": false,
    "fields": {
      "FullName": [
        {
          "type": "string",
          "analyzer": "fold",
          "multi": { "ar": { "type": "string", "analyzer": "lucene.arabic" } }
        },
        {
          "type": "autocomplete",
          "analyzer": "fold",
          "tokenization": "edgeGram",
          "minGrams": 2,
          "maxGrams": 15
        }
      ],
      "Company": [
        {
          "type": "string",
          "analyzer": "fold",
          "multi": { "ar": { "type": "string", "analyzer": "lucene.arabic" } }
        },
        {
          "type": "autocomplete",
          "analyzer": "fold",
          "tokenization": "edgeGram",
          "minGrams": 2,
          "maxGrams": 15
        }
      ],
      "Position": [
        {
          "type": "string",
          "analyzer": "fold",
          "multi": { "ar": { "type": "string", "analyzer": "lucene.arabic" } }
        },
        {
          "type": "autocomplete",
          "analyzer": "fold",
          "tokenization": "edgeGram",
          "minGrams": 2,
          "maxGrams": 15
        }
      ],
      "City": {
        "type": "string",
        "analyzer": "fold",
        "multi": { "ar": { "type": "string", "analyzer": "lucene.arabic" } }
      },
      "Notes": {
        "type": "string",
        "analyzer": "fold",
        "multi": { "ar": { "type": "string", "analyzer": "lucene.arabic" } }
      },
      "Sector": [{ "type": "string", "analyzer": "fold" }, { "type": "token" }],
      "Email": { "type": "string", "analyzer": "fold" },
      "Mobile": { "type": "string", "analyzer": "lucene.keyword" },
      "CreatedAt": { "type": "date" },
      "DepartmentId": { "type": "objectId" }
    }
  }
}
